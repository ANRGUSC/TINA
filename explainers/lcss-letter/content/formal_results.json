          "A-L2"
        ]
      },
      {
        "id": "C.3",
        "parent": "C",
        "goal": "G-C",
        "statement": "Optimization separates across components. Apply Theorem 1 to each.",
        "source_id": "SRC-049",
        "source_lines": [
