        ]
      },
      {
        "id": "R.4.3",
        "parent": "R.4",
        "goal": "R.4",
        "statement": "At the root, $c-B(T^*)=-T^*V_\\delta(T^*)$, giving the optimal-cost formula.",
        "source_id": "SRC-056",
        "source_lines": [
          304,
          304
        ],
        "kind": "NORMALIZED",
        "support": "EXPLICIT",
        "deps": [
          "R.4.1",
          "D-refresh"
        ]
      },
      {
        "id": "R.4.4",
        "parent": "R.4",
        "goal": "R.4",
        "statement": "Q.E.D. The below-threshold periodic claims hold.",
        "source_id": "SRC-057",
        "source_lines": [
