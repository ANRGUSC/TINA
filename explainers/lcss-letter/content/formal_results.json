[
  {
    "id": "L",
    "name": "Lemma 1: Team optimality",
    "label": "lem:normal",
    "eqs": "(3), (5)",
    "contract": "For the information fields $\\mathcal G_i$, optimize over $u_i\\in L^2(\\mathcal G_i)$, with $X\\in L^2$, $n\\ge2$, and $\\kappa\\ge0$. A feasible $u$ is optimal exactly when\n\\[\n(1+\\kappa)u_i-\\kappa\\E[\\bar u\\mid\\mathcal G_i]=\\E[X\\mid\\mathcal G_i]\\quad(i=1,\\ldots,n).\n\\]\nTwo optimal feasible policies agree almost surely.",
    "source_start": 102,
    "source_end": 112,
    "steps": [
      {
        "id": "L.1",
        "parent": "L",
        "goal": "G-L",
        "statement": "For a feasible perturbation $w$, the objective difference has linear term $2n^{-1}\\sum_i\\E[w_i((1+\\kappa)u_i-\\kappa\\bar u-X)]$ and a quadratic remainder.",
        "source_id": "SRC-001",
        "source_lines": [
          111,
          111
        ],
        "kind": "NORMALIZED",
        "support": "EXPLICIT",
        "deps": [
          "A-L2",
          "D-loss"
        ]
      },
      {
        "id": "L.2",
        "parent": "L",
        "goal": "G-L",
        "statement": "The linear term vanishes for every feasible $w$ if and only if the conditional normal equations (5) hold.",
        "source_id": "SRC-002",
        "source_lines": [
          111,
          111
        ],
        "kind": "NORMALIZED",
        "support": "EXPLICIT",
        "deps": [
          "L.1",
          "B-CE"
        ]
      },
      {
        "id": "L.3",
        "parent": "L",
        "goal": "G-L",
        "statement": "The remainder is $n^{-1}\\sum_i\\E[w_i^2]+\\kappa n^{-1}\\sum_i\\E[(w_i-\\bar w)^2]$, positive whenever $w$ is nonzero in $L^2$.",
        "source_id": "SRC-003",
        "source_lines": [
          111,
          111
        ],
        "kind": "NORMALIZED",
        "support": "EXPLICIT",
        "deps": [
          "A-L2",
          "D-loss"
        ]
      },
      {
        "id": "L.4",
        "parent": "L",
        "goal": "G-L",
        "statement": "Q.E.D. Necessity, sufficiency, and uniqueness follow.",
        "source_id": "SRC-004",
        "source_lines": [
          111,
          112
        ],
        "kind": "STRUCTURAL",
        "support": "EXPLICIT",
        "deps": [
          "L.1",
          "L.2",
          "L.3"
        ]
      }
    ]
  },
  {
    "id": "P",
    "name": "Proposition 1: Fresh endpoints",
    "label": "prop:endpoints",
    "eqs": "(6)--(11)",
    "contract": "Under (1)--(3), let $v=a+b/n$ and $d=a+b[1+\\kappa(1-1/n)]$. For complete local and pooled histories,\n\\[\nP_1=\\frac{ab}{a+b},\\quad P_n=\\frac{ab}{b+na},\\quad\nu_i^L=\\frac adY_i(t),\\quad u_i^P=\\frac av\\bar Y(t).\n\\]\nThe optimal losses are $J_L=a-a^2/d$ and $J_P=P_n=a-a^2/v$, and $\\Delta=J_L-J_P=a^2(d-v)/(vd)>0$.",
    "source_start": 117,
    "source_end": 145,
    "steps": [
      {
        "id": "P.1",
        "parent": "P",
        "goal": "G-P",
        "statement": "$X(t)-aY_i(t)/(a+b)$ has zero covariance with every $Y_i(r)$ for $r\\le t$, so it is independent of the local history.",
        "source_id": "SRC-005",
        "source_lines": [
          134,
          134
        ],
        "kind": "NORMALIZED",
        "support": "EXPLICIT",
        "deps": [
          "A-G",
          "D-Y",
          "B-G"
        ]
      },
      {
        "id": "P.2",
        "parent": "P",
        "goal": "G-P",
        "statement": "Define $\\eta(t)=X(t)-(a/v)\\bar Y(t)$. It is uncorrelated with every $Y_j(r)$ and independent of the entire sensor process.",
        "source_id": "SRC-006",
        "source_lines": [
          134,
          138
        ],
        "kind": "NORMALIZED",
        "support": "EXPLICIT",
        "deps": [
          "A-G",
          "D-Y",
          "B-G"
        ]
      },
      {
        "id": "P.3",
        "parent": "P",
        "goal": "G-P",
        "statement": "The residual variances are $P_1=ab/(a+b)$ and $P_n=ab/(b+na)$. The corresponding conditional means are $aY_i(t)/(a+b)$ and $(a/v)\\bar Y(t)$.",
        "source_id": "SRC-007",
        "source_lines": [
          138,
          140
        ],
        "kind": "NORMALIZED",
        "support": "EXPLICIT",
        "deps": [
          "P.1",
          "P.2",
          "B-CE"
        ]
      },
      {
        "id": "P.4",
        "parent": "P",
        "goal": "G-P",
        "statement": "For the candidate $u_i=kY_i(t)$, $\\E[\\bar u\\mid\\mathcal F_i(t)]=kvY_i(t)/(a+b)$.",
        "source_id": "SRC-008",
        "source_lines": [
          140,
          142
        ],
        "kind": "NORMALIZED",
        "support": "EXPLICIT",
        "deps": [
          "A-G",
          "D-Y",
          "B-G"
        ]
      },
      {
        "id": "P.5",
        "parent": "P",
        "goal": "G-P",
        "statement": "Equation (5) gives $k[(1+\\kappa)(a+b)-\\kappa v]=a$. The bracket equals $d$, so $k=a/d$.",
        "source_id": "SRC-009",
        "source_lines": [
          142,
          144
        ],
        "kind": "NORMALIZED",
        "support": "EXPLICIT",
        "deps": [
          "L",
          "P.3",
          "P.4",
          "D-vd"
        ]
      },
      {
        "id": "P.6",
        "parent": "P",
        "goal": "G-P",
        "statement": "The local loss is $a-2ak+dk^2=a-a^2/d$.",
        "source_id": "SRC-010",
        "source_lines": [
          144,
          144
        ],
        "kind": "NORMALIZED",
        "support": "EXPLICIT",
        "deps": [
          "P.5",
          "D-loss"
        ]
      },
      {
        "id": "P.7",
        "parent": "P",
        "goal": "G-P",
        "statement": "With pooled information all agents use the common conditional mean, with zero disagreement and loss $P_n$.",
        "source_id": "SRC-011",
        "source_lines": [
          144,
          144
        ],
        "kind": "NORMALIZED",
        "support": "EXPLICIT",
        "deps": [
          "P.3",
          "B-CE",
          "D-loss"
        ]
      },
      {
        "id": "P.8",
        "parent": "P",
        "goal": "G-P",
        "statement": "The displayed feasible policies are optimal by Lemma 1.",
        "source_id": "SRC-012",
        "source_lines": [
          144,
          144
        ],
        "kind": "NORMALIZED",
        "support": "EXPLICIT",
        "deps": [
          "L",
          "P.5",
          "P.7"
        ]
      },
      {
        "id": "P.9",
        "parent": "P",
        "goal": "G-P",
        "statement": "$d-v=b(1+\\kappa)(1-1/n)>0$ and subtraction yields the formula for $\\Delta$.",
        "source_id": "SRC-013",
        "source_lines": [
          144,
          145
        ],
        "kind": "NORMALIZED",
        "support": "EXPLICIT",
        "deps": [
          "A-G",
          "D-vd",
          "P.6",
          "P.7"
        ]
      },
      {
        "id": "P.10",
        "parent": "P",
        "goal": "G-P",
        "statement": "Q.E.D. All endpoint claims follow.",
        "source_id": "SRC-013",
        "source_lines": [
          144,
