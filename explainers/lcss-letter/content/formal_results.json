          192
        ],
        "kind": "STRUCTURAL",
        "support": "EXPLICIT",
        "deps": [
          "A-G"
        ]
      },
      {
        "id": "H.2.1",
        "parent": "H.2",
        "goal": "H.2",
        "statement": "Enlarge each information field to $\\mathcal G_i=\\mathcal F(s)\\vee\\mathcal F_i(t)$ and define $Z_i=Y_i(t)-\\rho Y_i(s)$, $h=a/v$, $k=a/d$.",
        "source_id": "SRC-021",
        "source_lines": [
          192,
          196
        ],
        "kind": "NORMALIZED",
        "support": "EXPLICIT",
        "deps": [
          "D-info",
          "D-vd"
        ]
      },
      {
        "id": "H.2.2",
        "parent": "H.2",
        "goal": "H.2",
        "statement": "$Z$ is independent of $\\mathcal F(s)$ and has covariance $(1-\\rho^2)(a\\mathbf1\\mathbf1^\\top+bI)$.",
        "source_id": "SRC-022",
        "source_lines": [
          196,
          196
        ],
        "kind": "NORMALIZED",
        "support": "EXPLICIT",
        "deps": [
          "H.2.1",
          "A-G",
          "B-OU",
          "B-G"
        ]
      },
      {
        "id": "H.2.3",
        "parent": "H.2",
        "goal": "H.2",
        "statement": "$X(t)=\\rho h\\bar Y(s)+h\\bar Z+\\eta(t)$, where $\\eta(t)$ is independent of all sensor data and has variance $P_n$.",
        "source_id": "SRC-023",
        "source_lines": [
          196,
          202
        ],
        "kind": "NORMALIZED",
        "support": "EXPLICIT",
        "deps": [
          "H.2.1",
          "E-eta",
          "P"
        ]
      },
      {
        "id": "H.2.4",
        "parent": "H.2",
        "goal": "H.2",
        "statement": "For $s<r\\le t$, define $Z_i(r)=Y_i(r)-e^{-\\lambda(r-s)}Y_i(s)$. Then $\\Cov(\\bar Z,Z_i(r))=[v/(a+b)]\\Cov(Z_i,Z_i(r))$.",
        "source_id": "SRC-024",
        "source_lines": [
          202,
