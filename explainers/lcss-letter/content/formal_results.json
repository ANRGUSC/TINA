        ],
        "kind": "NORMALIZED",
        "support": "EXPLICIT",
        "deps": [
          "H.2.4",
          "A-G"
        ]
      },
      {
        "id": "H.2.6",
        "parent": "H.2",
        "goal": "H.2",
        "statement": "$\\bar Z-vZ_i/(a+b)$ is orthogonal to the entire local innovation path and to $\\mathcal F(s)$.",
        "source_id": "SRC-026",
