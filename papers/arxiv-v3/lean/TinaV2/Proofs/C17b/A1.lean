import TinaV2.Statements
import TinaV2.Routine.Canonical
import TinaV2.Routine.CanonicalTime
import TinaV2.Routine.ProcessLaw

/-! # C17.b, attempt A1: mirrors the paper's proof

Paper: `main-v2.tex`, the paragraph after Eq. (temporal_propagation_length),
lines 839-855. One lemma per sentence of the paper's proof, in the paper's
order, then `main`.

Notation. `a = e^{−τ/T}` is written out as `exp (-τ / T)`. The innovation field
is `y ↦ θ(y,t) − a θ(y,t−τ)`, the field at time `t − τ` is `y ↦ θ(y,t−τ)`, the
target `x⋆(z,s)` is `lineTarget θ ℓc z s`, and `𝒪[θ, r, z, s]` is the
sigma-algebra generated by the observed interval `𝒪_r(z,s)`. `lineR … τ z t`
is the regret of acting at time `t` on the interval observed at time `t − τ`. -/

namespace TinaV2.C17b.A1

open MeasureTheory ProbabilityTheory Real Set

variable {Ω : Type} [mΩ : MeasurableSpace Ω] {μ : Measure Ω} {θ : ℝ → ℝ → Ω → ℝ}
  {σ ℓs T ℓc q τ : ℝ}

/-- Step 1 (main-v2.tex 839-843). "By the separable covariance in
(canonical_space_time_covariance), the innovation `θ(y,t) − aθ(y,t−τ)` is
uncorrelated with `θ(y',t−τ)` for every `y, y'`."
Beyond the sentence: the products are integrable, and `|t − (t − τ)| = τ`
because `τ ≥ 0`. -/
theorem s1_innovation_uncorrelated (h : CanonicalField μ θ σ ℓs T) (hτ : 0 ≤ τ) (t : ℝ) :
    ∀ y y', ∫ ω, (θ y t ω - exp (-τ / T) * θ y (t - τ) ω) * θ y' (t - τ) ω ∂μ = 0 := by
  intro y y'
  have h1 : Integrable (fun ω => θ y t ω * θ y' (t - τ) ω) μ :=
    (h.memLp y t).integrable_mul (h.memLp y' (t - τ))
  have h2 : Integrable (fun ω => exp (-τ / T) * (θ y (t - τ) ω * θ y' (t - τ) ω)) μ :=
    ((h.memLp y (t - τ)).integrable_mul (h.memLp y' (t - τ))).const_mul _
  have hpt : ∀ ω, (θ y t ω - exp (-τ / T) * θ y (t - τ) ω) * θ y' (t - τ) ω
      = θ y t ω * θ y' (t - τ) ω - exp (-τ / T) * (θ y (t - τ) ω * θ y' (t - τ) ω) :=
    fun ω => by ring
  have habs : |t - (t - τ)| = τ := by rw [sub_sub_cancel, abs_of_nonneg hτ]
  simp_rw [hpt]
  rw [integral_sub h1 h2, integral_const_mul, h.cov, h.cov_same_time, habs]
  ring

/-- Step 2 (main-v2.tex 843-844). "Joint Gaussianity therefore makes the
innovation field independent of the entire field at time `t−τ`."
Beyond the sentence: the pair (innovation field, old field) is a Gaussian
process because its values are linear combinations of values of the field, and
the field is centred, so the covariance is the mixed second moment of step 1. -/
theorem s2_innovation_independent [IsProbabilityMeasure μ] (h : CanonicalField μ θ σ ℓs T)
    (hτ : 0 ≤ τ) (t : ℝ) :
    IndepFun (fun ω (y : ℝ) => θ y t ω - exp (-τ / T) * θ y (t - τ) ω)
      (fun ω (y : ℝ) => θ y (t - τ) ω) μ := by
  have hG := h.isGaussianProcess_innovation_sum (exp (-τ / T)) t (t - τ)
  refine hG.indepFun_of_covariance_eq_zero
    (X := fun (y : ℝ) ω => θ y t ω - exp (-τ / T) * θ y (t - τ) ω)
    (Y := fun (y : ℝ) => θ y (t - τ))
    (fun y => ((h.measurable y t).sub ((h.measurable y (t - τ)).const_mul _)).aemeasurable)
    (fun y => (h.measurable y (t - τ)).aemeasurable) fun y y' => ?_
  have hX : MemLp (fun ω => θ y t ω - exp (-τ / T) * θ y (t - τ) ω) 2 μ :=
    (h.memLp y t).sub ((h.memLp y (t - τ)).const_mul _)
  rw [covariance_eq_sub hX (h.memLp y' (t - τ)), h.mean y' (t - τ), mul_zero, sub_zero]
  exact s1_innovation_uncorrelated h hτ t y y'

/-- Step 3 (main-v2.tex 845-850). "Integrating against the decision kernel in
(canonical_target) and conditioning on the observed interval gives
`E[x⋆(z,t) | 𝒪_r(z,t−τ)] = a E[x⋆(z,t−τ) | 𝒪_r(z,t−τ)]`."
Beyond the sentence: the integrated innovation is a centred function of the
innovation field, and the observed interval is a function of the field at time
`t − τ`, so step 2 makes the two independent. -/
theorem s3_condExp_scales [IsProbabilityMeasure μ] (h : CanonicalField μ θ σ ℓs T)
    (hℓc : 0 < ℓc) (hτ : 0 ≤ τ) (z t r : ℝ) :
    μ[lineTarget θ ℓc z t | lineObsSigma θ r z (t - τ)]
      =ᵐ[μ] fun ω => exp (-τ / T) * (μ[lineTarget θ ℓc z (t - τ) | lineObsSigma θ r z (t - τ)]) ω := by
  -- integrating against the kernel: `x⋆(z,t) = a x⋆(z,t−τ) + W`
  have hsplit : lineTarget θ ℓc z t =ᵐ[μ] exp (-τ / T) • lineTarget θ ℓc z (t - τ)
      + fun ω => ∫ u, lineKernel ℓc u
        * (θ (z + u) t ω - exp (-τ / T) * θ (z + u) (t - τ) ω) :=
    h.lineTarget_ae_eq_add hℓc (exp (-τ / T)) z t (t - τ)
  have hXi : Integrable (lineTarget θ ℓc z (t - τ)) μ :=
    (h.memLp_lineTarget hℓc z (t - τ)).integrable one_le_two
  have hWi : Integrable (fun ω => ∫ u, lineKernel ℓc u
      * (θ (z + u) t ω - exp (-τ / T) * θ (z + u) (t - τ) ω)) μ :=
    ((h.innovation (exp (-τ / T)) z t (t - τ)).memLp_integral (measurable_lineKernel ℓc)
      (integrable_lineKernel hℓc)).integrable one_le_two
  -- the innovation field is independent of the observed interval (step 2)
  have hind : Indep (MeasurableSpace.comap
        (fun ω (y : ℝ) => θ y t ω - exp (-τ / T) * θ y (t - τ) ω) MeasurableSpace.pi)
      (lineObsSigma θ r z (t - τ)) μ :=
    indep_of_indep_of_le_right
      ((IndepFun_iff_Indep _ _ _).1 (s2_innovation_independent h hτ t))
      (comap_lineObs_le θ r z (t - τ))
  have hεm : Measurable[mΩ] fun ω (y : ℝ) => θ y t ω - exp (-τ / T) * θ y (t - τ) ω :=
    measurable_pi_lambda _ fun y => (h.measurable y t).sub ((h.measurable y (t - τ)).const_mul _)
  -- so conditioning the integrated innovation on the interval gives its mean, zero
  have hW : μ[fun ω => ∫ u, lineKernel ℓc u
        * (θ (z + u) t ω - exp (-τ / T) * θ (z + u) (t - τ) ω) | lineObsSigma θ r z (t - τ)]
      =ᵐ[μ] fun _ => ∫ ω, (∫ u, lineKernel ℓc u
        * (θ (z + u) t ω - exp (-τ / T) * θ (z + u) (t - τ) ω)) ∂μ :=
    condExp_indep_eq hεm.comap_le (h.measurable_lineObs r z (t - τ)).comap_le
      (h.stronglyMeasurable_innovation_integral ℓc (exp (-τ / T)) z t (t - τ)) hind
  filter_upwards [condExp_congr_ae (m := lineObsSigma θ r z (t - τ)) hsplit,
    condExp_add (hXi.smul (exp (-τ / T))) hWi (lineObsSigma θ r z (t - τ)),
    condExp_smul (exp (-τ / T)) (lineTarget θ ℓc z (t - τ)) (lineObsSigma θ r z (t - τ)), hW]
    with ω e1 e2 e3 e4
  rw [e1, e2, Pi.add_apply, e3, e4, h.integral_innovation_integral hℓc, Pi.smul_apply,
    smul_eq_mul, add_zero]

/-- Step 4 (main-v2.tex 851-852). "Under the pointwise squared loss, the gain
over acting without observations is `q/2` times the variance of the conditional
mean." Stated for the interval observed at any delay `s`.
Beyond the sentence: the conditional mean is the best rule (`lineR_eq`) and the
law of total variance. -/
theorem s4_gain_variance [IsProbabilityMeasure μ] (h : CanonicalField μ θ σ ℓs T)
    (hℓc : 0 < ℓc) (hq : 0 < q) (z t r s : ℝ) :
    lineRinf μ q θ ℓc z t - lineR μ q θ ℓc r s z t
      = q / 2 * Var[μ[lineTarget θ ℓc z t | lineObsSigma θ r z (t - s)]; μ] := by
  rw [h.lineR_eq hℓc hq, integral_condVar_eq_variance_sub
    (h.measurable_lineObs r z (t - s)).comap_le (h.memLp_lineTarget hℓc z t), lineRinf]
  ring

/-- Step 5 (main-v2.tex 852-854). "By stationarity, the conditional mean at time
`t−τ` has the same variance as its fresh-snapshot counterpart at time `t`."
Beyond the sentence: stationarity is read off the covariance (the spatial
slices at the two times are Gaussian with the same means and second moments,
hence the same law), the pair (target, observed interval) is one fixed
measurable function of the slice, and the variance of the conditional mean is
the variance of the target minus the expected conditional variance. -/
theorem s5_stationarity [IsProbabilityMeasure μ] (h : CanonicalField μ θ σ ℓs T)
    (hℓc : 0 < ℓc) (z t r τ : ℝ) :
    Var[μ[lineTarget θ ℓc z (t - τ) | lineObsSigma θ r z (t - τ)]; μ]
      = Var[μ[lineTarget θ ℓc z t | lineObsSigma θ r z t]; μ] := by
  -- the spatial slices at the two times have the same law
  have hlaw : IdentDistrib (fun ω (u : ℝ) => θ (z + u) (t - τ) ω)
      (fun ω (u : ℝ) => θ (z + u) t ω) μ μ :=
    identDistrib_of_isGaussianProcess (X := fun (u : ℝ) => θ (z + u) (t - τ))
      (Y := fun (u : ℝ) => θ (z + u) t)
      (h.gaussian.comp_right fun u : ℝ => (z + u, t - τ))
      (h.gaussian.comp_right fun u : ℝ => (z + u, t))
      (fun u => h.measurable _ _) (fun u => h.measurable _ _)
      (fun u => by rw [h.mean, h.mean])
      (fun u u' => by rw [h.cov_same_time, h.cov_same_time])
  -- hence so do the pairs (target, slice) and (target, observed interval)
  have hjoint := identDistrib_integral_prodMk (h.slice z (t - τ)) (h.slice z t)
    (fun u => h.measurable _ _) (fun u => h.measurable _ _)
    (fun ω => (h.continuous (t - τ) ω).comp (continuous_const.add continuous_id)) hlaw
    (measurable_lineKernel ℓc) volume (integrable_lineKernel hℓc)
  have hρ : Measurable fun p : ℝ × (ℝ → ℝ) => (p.1, fun u : Icc (-r) r => p.2 (u : ℝ)) :=
    measurable_fst.prodMk
      (measurable_pi_lambda _ fun u => (measurable_pi_apply (u : ℝ)).comp measurable_snd)
  have hpair : IdentDistrib
      (fun ω => (lineTarget θ ℓc z (t - τ) ω, lineObs θ r z (t - τ) ω))
      (fun ω => (lineTarget θ ℓc z t ω, lineObs θ r z t ω)) μ μ := hjoint.comp hρ
  -- same variance of the target, same expected conditional variance
  have hvar : Var[lineTarget θ ℓc z (t - τ); μ] = Var[lineTarget θ ℓc z t; μ] :=
    (hpair.comp measurable_fst).variance_eq
  have hcv : ∫ ω, Var[lineTarget θ ℓc z (t - τ); μ | lineObsSigma θ r z (t - τ)] ω ∂μ
      = ∫ ω, Var[lineTarget θ ℓc z t; μ | lineObsSigma θ r z t] ω ∂μ :=
    integral_condVar_congr_identDistrib (h.memLp_lineTarget hℓc z (t - τ))
      (h.memLp_lineTarget hℓc z t) (h.measurable_lineObs r z (t - τ))
      (h.measurable_lineObs r z t) hpair
  have e1 := integral_condVar_eq_variance_sub (h.measurable_lineObs r z (t - τ)).comap_le
    (h.memLp_lineTarget hℓc z (t - τ))
  have e2 := integral_condVar_eq_variance_sub (h.measurable_lineObs r z t).comap_le
    (h.memLp_lineTarget hℓc z t)
  linarith

/-- Step 6 (main-v2.tex 854-855). "The delayed interval therefore retains `a²`
times the gain from a fresh interval of the same radius."
Beyond the sentence: `Var(aY) = a² Var(Y)`. -/
theorem s6_retains [IsProbabilityMeasure μ] (h : CanonicalField μ θ σ ℓs T) (hℓc : 0 < ℓc)
    (hq : 0 < q) (hτ : 0 ≤ τ) (z t r : ℝ) :
    lineRinf μ q θ ℓc z t - lineR μ q θ ℓc r τ z t
      = exp (-τ / T) ^ 2 * (lineRinf μ q θ ℓc z t - lineR μ q θ ℓc r 0 z t) := by
  have hfresh := s4_gain_variance h hℓc hq z t r 0
  rw [sub_zero] at hfresh
  rw [s4_gain_variance h hℓc hq z t r τ, hfresh,
    variance_congr (s3_condExp_scales h hℓc hτ z t r), variance_const_mul,
    s5_stationarity h hℓc z t r τ]
  ring

/-- C17.b: the composition law holds in the continuum model. The conditional
mean identity is step 3 and the retained gain is step 6. -/
theorem main : C17b.Statement := by
  intro Ω _ μ _ θ σ ℓs T ℓc q h hℓc hq z t r τ _ hτ
  exact ⟨s3_condExp_scales h hℓc hτ z t r, s6_retains h hℓc hq hτ z t r⟩

end TinaV2.C17b.A1
