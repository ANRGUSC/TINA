import TinaV2.Routine.Canonical

/-! # Routine: the canonical field at two times

Regularity behind the delayed-observation paragraph of the canonical model
(claim C17.b). The paper writes the innovation `θ(y,t) − a θ(y,s)` and
integrates it against the decision kernel without comment. Here: the pair
(innovation field, old field) is again a Gaussian process, the innovation can
be integrated against the kernel, the target splits almost surely into `a`
times the old target plus the integrated innovation, that integrated innovation
is a centred function of the innovation field, and the observed interval is a
function of the whole field at its time.

Nothing here uses the covariance of the field. -/

noncomputable section

namespace TinaV2

open MeasureTheory ProbabilityTheory Real Set

variable {Ω : Type} [mΩ : MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
  {θ : ℝ → ℝ → Ω → ℝ} {σ ℓs T : ℝ}

omit mΩ in
/-- The observed interval `𝒪_r(z,s)` is a function of the whole spatial field at
time `s`: its sigma-algebra is contained in the one generated by that field. -/
theorem comap_lineObs_le (θ : ℝ → ℝ → Ω → ℝ) (r z s : ℝ) :
    MeasurableSpace.comap (lineObs θ r z s) MeasurableSpace.pi
      ≤ MeasurableSpace.comap (fun ω (y : ℝ) => θ y s ω) MeasurableSpace.pi := by
  have hρ : Measurable fun (f : ℝ → ℝ) (u : Icc (-r) r) => f (z + u) :=
    measurable_pi_lambda _ fun u => measurable_pi_apply _
  have hcomp : lineObs θ r z s
      = (fun (f : ℝ → ℝ) (u : Icc (-r) r) => f (z + u)) ∘ fun ω (y : ℝ) => θ y s ω := rfl
  rw [hcomp, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono hρ.comap_le

namespace CanonicalField

omit [IsProbabilityMeasure μ] in
/-- The innovation field `θ(·,t) − a θ(·,s)` together with the field at time `s`
is a Gaussian process: each of its values is a linear combination of at most
two values of the space-time field. -/
theorem isGaussianProcess_innovation_sum (h : CanonicalField μ θ σ ℓs T) (a t s : ℝ) :
    IsGaussianProcess
      (Sum.elim (fun (y : ℝ) ω => θ y t ω - a * θ y s ω) (fun (y : ℝ) => θ y s)) μ := by
  classical
  refine h.gaussian.of_isGaussianProcess fun i => ?_
  rcases i with y | y
  · refine ⟨{(y, t), (y, s)},
      ContinuousLinearMap.proj (R := ℝ) (φ := fun _ => ℝ) ⟨(y, t), by simp⟩
        - a • ContinuousLinearMap.proj (R := ℝ) (φ := fun _ => ℝ) ⟨(y, s), by simp⟩,
      fun ω => ?_⟩
    simp
  · exact ⟨{(y, s)}, ContinuousLinearMap.proj (R := ℝ) (φ := fun _ => ℝ) ⟨(y, s), by simp⟩,
      fun ω => by simp⟩

omit [IsProbabilityMeasure μ] in
/-- The innovation of a spatial slice, recentred at `z`, can be integrated over
the location. -/
theorem innovation (h : CanonicalField μ θ σ ℓs T) (a z t s : ℝ) :
    L2Process μ (fun u ω => θ (z + u) t ω - a * θ (z + u) s ω) :=
  (h.slice z t).sub
    ((h.slice z s).coeff_mul (c := fun _ => a) measurable_const ⟨|a|, fun _ => le_rfl⟩)

/-- Linearity of the kernel integral: almost surely
`x⋆(z,t) = a x⋆(z,s) + ∫ w(u) [θ(z+u,t) − a θ(z+u,s)] du`. -/
theorem lineTarget_ae_eq_add (h : CanonicalField μ θ σ ℓs T) {ℓc : ℝ} (hℓc : 0 < ℓc)
    (a z t s : ℝ) :
    lineTarget θ ℓc z t =ᵐ[μ] fun ω => a * lineTarget θ ℓc z s ω
      + ∫ u, lineKernel ℓc u * (θ (z + u) t ω - a * θ (z + u) s ω) := by
  have hs : L2Process μ (fun u ω => a * θ (z + u) s ω) :=
    (h.slice z s).coeff_mul (c := fun _ => a) measurable_const ⟨|a|, fun _ => le_rfl⟩
  filter_upwards [(h.slice z t).integral_sub_ae hs (measurable_lineKernel ℓc)
    (integrable_lineKernel hℓc)] with ω hω
  have hpull : ∫ u, lineKernel ℓc u * (a * θ (z + u) s ω)
      = a * ∫ u, lineKernel ℓc u * θ (z + u) s ω := by
    rw [← integral_const_mul]
    exact integral_congr_ae (ae_of_all _ fun u => by ring)
  rw [hω, hpull]
  unfold lineTarget
  ring

omit [IsProbabilityMeasure μ] in
/-- The integrated innovation is a function of the innovation field. -/
theorem stronglyMeasurable_innovation_integral (h : CanonicalField μ θ σ ℓs T)
    (ℓc a z t s : ℝ) :
    StronglyMeasurable[MeasurableSpace.comap (fun ω (y : ℝ) => θ y t ω - a * θ y s ω)
        MeasurableSpace.pi]
      fun ω => ∫ u, lineKernel ℓc u * (θ (z + u) t ω - a * θ (z + u) s ω) :=
  stronglyMeasurable_integral_of_continuous
    (ψ := fun u ω => θ (z + u) t ω - a * θ (z + u) s ω)
    (fun u => (measurable_pi_apply (X := fun _ : ℝ => ℝ) (z + u)).comp
      (comap_measurable fun ω (y : ℝ) => θ y t ω - a * θ y s ω))
    (fun ω => ((h.continuous t ω).comp (continuous_const.add continuous_id)).sub
      (continuous_const.mul ((h.continuous s ω).comp (continuous_const.add continuous_id))))
    (measurable_lineKernel ℓc) volume

/-- The integrated innovation is centred. -/
theorem integral_innovation_integral (h : CanonicalField μ θ σ ℓs T) {ℓc : ℝ} (hℓc : 0 < ℓc)
    (a z t s : ℝ) :
    ∫ ω, (∫ u, lineKernel ℓc u * (θ (z + u) t ω - a * θ (z + u) s ω)) ∂μ = 0 := by
  rw [(h.innovation a z t s).integral_integral (measurable_lineKernel ℓc)
    (integrable_lineKernel hℓc)]
  have h0 : ∀ u : ℝ, ∫ ω, (θ (z + u) t ω - a * θ (z + u) s ω) ∂μ = 0 := fun u => by
    rw [integral_sub ((h.memLp _ _).integrable one_le_two)
      (((h.memLp _ _).integrable one_le_two).const_mul a), integral_const_mul, h.mean, h.mean]
    ring
  simp [h0]

end CanonicalField

end TinaV2
